# Cloudflare Pages custom headers (served directly: no Pages worker, so static
# requests don't count against the account's Workers request quota).
#
# Security headers for every path. Permissions-Policy: only our own origin may
# ask for location; camera/mic/etc. are off. CSP is report-only for now (Flutter
# web needs wasm + inline bootstrap; MapTiler, gstatic, unpkg) - switch to
# enforcing once a few days of reports are clean.
/*
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://unpkg.com https://www.gstatic.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://*.maptiler.com https://upload.wikimedia.org; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://upload.wikimedia.org https://api.stize.app https://api-staging.stize.app https://*.theoutlines.workers.dev https://*.maptiler.com https://www.gstatic.com https://fonts.gstatic.com https://cloudflareinsights.com; worker-src 'self' blob:; frame-ancestors 'none'

/index.html
  Cache-Control: public, max-age=0, must-revalidate
/flutter_bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate
/main.dart.js
  Cache-Control: public, max-age=0, must-revalidate
/flutter_service_worker.js
  Cache-Control: public, max-age=0, must-revalidate
/version.json
  Cache-Control: public, max-age=0, must-revalidate
